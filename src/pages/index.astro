---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import PainPoints from "../components/PainPoints.astro"
import HowItWorks from "../components/HowItWorks.astro"
import AboutLawyer from "../components/AboutLawyer.astro"
import Differentiators from "../components/Differentiators.astro"
import Testimonials from "../components/Testimonials.astro"
import FAQ from "../components/FAQ.astro"
import FinalCTA from "../components/FinalCTA.astro"
import Footer from "../components/Footer.astro"

const title = "Ricardo Lauer Advocacia — Especialista em Direito Trabalhista"
const description = "Atendimento especializado em Direito Trabalhista. Receba uma análise inicial do seu caso pelo WhatsApp."
---

<BaseLayout {title} {description}>
  <main class="flex flex-col">
    <div class="flex max-md:flex-col md:h-screen md:flex-col">
      <Hero />
    </div>
    <PainPoints />
    <HowItWorks />
    <AboutLawyer />
    <Differentiators />
    <Testimonials />
    <FAQ />
    <FinalCTA />
    <Footer />
  </main>
</BaseLayout>
