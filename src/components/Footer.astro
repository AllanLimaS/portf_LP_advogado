---
import { SITE, CONTACT, SOCIAL, NAV_LINKS } from "../constants/site"
import Icon from "./ui/Icon.astro"

const { name, tagline, oab, copyright } = SITE
---

<footer class="w-full bg-dark-footer">
  <div class="mx-auto max-w-[1200px] flex flex-col items-center px-6 md:px-10 lg:px-16 pt-10 pb-6">
    <div class="flex w-full gap-8 border-b border-[#1f2937]/50 pb-8 max-md:flex-col">
      <div class="flex w-[442px] flex-col gap-4 max-md:w-full">
        <div class="flex items-end gap-1">
          <span class="font-heading text-base font-medium text-accent-light">Ricardo</span>
          <span class="font-heading text-base font-medium text-accent-dark">Lauer</span>
        </div>
        <span class="font-body text-[10px] text-accent-light/60 -mt-3">{oab}</span>
        <p class="w-[200px] font-body text-xs text-accent-light/60 leading-relaxed">{tagline}</p>
        <div class="flex gap-2">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <Icon name="instagram" size={15} class="text-accent-light opacity-50" />
          </a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <Icon name="linkedin" size={15} class="text-accent-light opacity-50" />
          </a>
          <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <Icon name="youtube" size={15} class="text-accent-light opacity-50" />
          </a>
        </div>
      </div>

      <div class="flex w-[315px] flex-col gap-4 max-md:w-full">
        <span class="font-body text-[11px] font-medium text-accent-dark tracking-[1.1px] uppercase">Contato</span>
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2">
            <Icon name="phone" size={14} class="text-border-dark" />
            <a href="tel:+5511999996868" class="font-body text-[13px] text-accent-light/60 hover:text-accent-dark transition-colors">{CONTACT.phone}</a>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="mail" size={14} class="text-border-dark" />
            <a href="mailto:contato@ricardolauer.adv.br" class="font-body text-[13px] text-accent-light/60 hover:text-accent-dark transition-colors">{CONTACT.email}</a>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="map-pin" size={14} class="text-border-dark" />
            <span class="font-body text-[13px] text-accent-light/60">{CONTACT.address}</span>
          </div>
        </div>
      </div>

      <div class="flex w-[315px] flex-col gap-4 max-md:w-full">
        <span class="font-body text-[11px] font-medium text-accent-dark tracking-[1.1px] uppercase">Navegação</span>
        <div class="flex flex-col gap-2">
          {NAV_LINKS.map((link) => (
            <a href={link.href} class="flex items-center gap-2 transition-opacity hover:opacity-70">
              <Icon name="chevron-right" size={14} class="text-border-dark" />
              <span class="font-body text-[13px] text-accent-light/60">{link.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="flex w-full flex-col items-center justify-center pt-5 gap-1">
      <span class="font-body text-[10px] text-accent-light/40">{copyright}</span>
      <span class="font-body text-[10px] text-accent-light/40">Site desenvolvido por Allan de Lima da Silva. Conteudo ficticio. Fotos de banco de imagens.</span>
    </div>
  </div>
</footer>
