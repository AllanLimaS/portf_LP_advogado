---
import { SITE, CONTACT, SOCIAL, NAV_LINKS } from "../constants/site"

const { name, tagline, copyright, oab } = SITE
---

<footer class="w-full bg-dark-footer">
  <div class="mx-auto max-w-[1200px] flex flex-col items-center px-8 pt-10 pb-6">
    <div class="flex w-full gap-8 border-b border-[#1f2937]/50 pb-8 max-md:flex-col">
      <div class="flex w-[442px] flex-col gap-4 max-md:w-full">
        <div class="flex items-end gap-1">
          <span class="font-heading text-base font-medium text-accent-light">Ricardo</span>
          <span class="font-heading text-base font-medium text-accent-dark">Almeida</span>
        </div>
        <p class="w-[200px] font-body text-xs text-accent-light/40 leading-relaxed">{tagline}</p>
        <div class="flex gap-2">
          <a href={SOCIAL.instagram} class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f1daaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href={SOCIAL.linkedin} class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f1daaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          </a>
          <a href={SOCIAL.youtube} class="flex h-8 w-8 items-center justify-center rounded-lg border border-[#1f2937]/50 bg-primary transition-opacity hover:opacity-80">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#f1daaa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-50"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29.94 29.94 0 0 0 1 12a29.94 29.94 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.94 2C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2A29.94 29.94 0 0 0 23 12a29.94 29.94 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon></svg>
          </a>
        </div>
      </div>

      <div class="flex w-[315px] flex-col gap-4 max-md:w-full">
        <span class="font-body text-[11px] font-medium text-accent-dark tracking-[1.1px] uppercase">Contato</span>
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#443605" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span class="font-body text-[13px] text-accent-light/50">{CONTACT.phone}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#443605" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <span class="font-body text-[13px] text-accent-light/50">{CONTACT.email}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#443605" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span class="font-body text-[13px] text-accent-light/50">{CONTACT.address}</span>
          </div>
        </div>
      </div>

      <div class="flex w-[315px] flex-col gap-4 max-md:w-full">
        <span class="font-body text-[11px] font-medium text-accent-dark tracking-[1.1px] uppercase">Navegação</span>
        <div class="flex flex-col gap-2">
          {NAV_LINKS.map((link) => (
            <a href={link.href} class="flex items-center gap-2 transition-opacity hover:opacity-70">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#443605" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              <span class="font-body text-[13px] text-accent-light/50">{link.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="flex w-full items-center justify-between pt-5">
      <span class="font-body text-[11px] text-accent-light/25">{copyright}</span>
      <span class="font-body text-[11px] text-accent-light/25">{oab}</span>
    </div>
  </div>
</footer>
