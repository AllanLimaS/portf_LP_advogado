---
import Icon from "./ui/Icon.astro"
import { PAIN_POINTS, WHATSAPP } from "../constants/site"
---

<section class="flex min-h-screen flex-col items-center justify-center gap-10 px-[100px] py-[60px] max-md:px-8" style="background: linear-gradient(180deg, #0d1117 0%, #111827 60px, #111827 100%);" aria-label="Pontos de dor do cliente">
  <h2 class="reveal text-center font-heading text-[30px] font-bold leading-tight bg-gradient-to-t from-white to-[#eccd8d] bg-clip-text text-transparent" data-reveal>
    Você passou por alguma dessas situações?
  </h2>

  <div class="reveal-stagger grid w-full grid-cols-3 gap-4 max-md:grid-cols-1" data-reveal>
    {PAIN_POINTS.map((item) => (
      <div class="reveal group relative flex flex-col items-center gap-4 rounded-xl px-8 py-7 transition-all duration-300 hover:scale-[1.02] hover:shadow-xl"
        style="background: linear-gradient(#111827, #111827) padding-box, linear-gradient(180deg, #c9a227, #433505) border-box; border: 2px solid transparent;" data-spotlight>
        <div class="card-overlay pointer-events-none absolute inset-0 rounded-xl bg-accent/4 opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
        <Icon name={item.icon} size={40} class="text-accent relative z-10" />
        <span class="relative z-10 text-center font-body text-[17px] text-white">{item.label}</span>
      </div>
    ))}
  </div>

  <a
    href="#"
    class="reveal inline-flex items-center gap-2 rounded-lg bg-gradient-to-t from-[#72530a] to-accent px-9 py-4 font-body text-base font-semibold text-white transition-all duration-300 hover:opacity-90 hover:scale-105 hover:shadow-[0_0_20px_rgba(204,167,51,0.3)]"
    data-reveal
  >
    Quero Analisar Meu Caso
    <span class="text-lg" aria-hidden="true">&rarr;</span>
  </a>
</section>
