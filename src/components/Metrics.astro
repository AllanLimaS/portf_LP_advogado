---
import { METRICS } from "../constants/site"
---

<section class="flex shrink-0 items-center py-8 max-md:hidden" style="background: linear-gradient(180deg, rgba(17,24,39,0.85) 0%, rgba(17,24,39,0.95) 50%, rgba(17,24,39,1) 100%);">
  <div class="mx-auto grid w-full max-w-[1200px] grid-cols-3 gap-4 px-[60px]">
    {METRICS.map((metric) => (
      <div class="flex flex-col items-center gap-1 rounded-lg py-3 px-2 text-center" style="background: rgba(255,255,255,0.05); border: 0.5px solid rgba(204,167,51,0.2);">
        <span class="font-heading text-[32px] font-bold text-accent-dark">{metric.value}</span>
        <span class="font-body text-xs text-accent-light/50">{metric.label}</span>
      </div>
    ))}
  </div>
</section>
