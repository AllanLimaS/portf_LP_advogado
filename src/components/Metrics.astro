---
import { METRICS } from "../constants/site"
---

<section class="flex shrink-0 items-center bg-primary py-8">
  <div class="mx-auto grid w-full max-w-[1200px] grid-cols-3 gap-6 px-[60px] max-md:grid-cols-2">
    {METRICS.map((metric, i) => (
      <div class={`flex flex-col items-center gap-1 ${i === METRICS.length - 1 ? "max-md:col-span-2" : ""}`}>
        <span class="font-heading text-[36px] font-bold text-accent max-md:text-[28px]">{metric.value}</span>
        <span class="font-body text-sm text-white max-md:text-xs">{metric.label}</span>
      </div>
    ))}
  </div>
</section>
