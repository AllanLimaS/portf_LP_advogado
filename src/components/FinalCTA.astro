---
import { Image } from 'astro:assets'
import { WHATSAPP } from "../constants/site"
import martelinhoImg from "../assets/images/martelinho.jpg"
---

<section class="relative flex min-h-[673px] flex-col items-center justify-center gap-6 overflow-hidden" aria-label="Chamada para ação final">
  <Image src={martelinhoImg} alt="" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-primary/80"></div>

  <div class="reveal-stagger relative z-10 flex flex-col items-center gap-6 px-6 md:px-10 lg:px-16 text-center" data-reveal>
    <div class="reveal flex flex-col items-center gap-1">
      <span class="font-display text-[34px] font-bold text-accent-light leading-snug">Não deixe seus direitos</span>
      <span class="font-display text-[62px] font-black text-accent-dark leading-tight">para depois</span>
    </div>

    <div class="reveal flex flex-col items-center gap-1">
      <p class="font-body text-base text-white">Fale agora com um especialista</p>
      <p class="font-body text-base text-white">e descubra as melhores opções para o seu caso.</p>
    </div>

    <div class="reveal">
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-lg btn-gradient-primary px-9 py-4 font-body text-base font-semibold text-white transition-all duration-300 hover:opacity-90 hover:scale-105 hover:btn-glow"
      >
        Falar pelo WhatsApp
      </a>
    </div>
  </div>
</section>
