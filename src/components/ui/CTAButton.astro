---
export interface Props {
  text: string
  icon?: string
  href?: string
  variant?: "gradient" | "solid"
  size?: "default" | "small"
  class?: string
}

const {
  text,
  icon,
  href = WHATSAPP.url,
  variant = "gradient",
  size = "default",
  class: extraClass = "",
} = Astro.props

const baseClasses = "inline-flex items-center justify-center gap-2 rounded-lg font-semibold font-body cursor-pointer transition-opacity hover:opacity-90"
const sizeClasses = size === "small" ? "px-5 py-2.5 text-sm" : "px-9 py-4 text-base"
const variantClasses = variant === "gradient"
  ? "bg-gradient-to-t from-[#72530a] to-[#c9a227] text-white"
  : "bg-accent-dark text-primary"
---

<a href={href} class={`${baseClasses} ${sizeClasses} ${variantClasses} ${extraClass}`}>
  {text}
  {icon && <span class="text-lg">{icon}</span>}
</a>
