---
export interface Props {
  text: string
  light?: boolean
}

const { text, light = false } = Astro.props
const dashColor = light ? "bg-accent-dark" : "bg-accent-dark"
const textColor = light ? "text-accent-dark" : "text-accent-dark"
---

<div class="flex items-center justify-center gap-3">
  <span class={`block h-0.5 w-8 ${dashColor}`}></span>
  <span class={`${textColor} font-body text-xs font-medium tracking-[1.2px] uppercase`}>
    {text}
  </span>
  <span class={`block h-0.5 w-8 ${dashColor}`}></span>
</div>
