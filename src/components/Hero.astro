---
import { SITE, WHATSAPP } from "../constants/site"

const { fullName, specialty } = SITE
---

<section class="relative flex flex-1 items-center overflow-hidden bg-primary max-md:flex-col">
  <img
    src="/imgs/fundo hero.jpg"
    alt=""
    class="absolute inset-0 h-full w-full object-cover blur-sm"
  />
  <div class="absolute inset-0 bg-primary/60"></div>

  <div class="absolute left-0 top-60 w-[900px] h-[700px] pointer-events-none blur-2xl"
    style="background: radial-gradient(ellipse 50% 40% at 30% 40%, rgba(17,24,39,1) 0%, rgba(17,24,39,0.94) 20%, rgba(17,24,39,0.6) 50%, rgba(17,24,39,0.1) 80%, rgba(17,24,39,0) 100%);">
  </div>

  <div class="absolute right-0 -top-24 w-[900px] h-[900px] pointer-events-none blur-2xl"
    style="background: radial-gradient(ellipse 40% 50% at 70% 30%, rgba(160,164,168,0.15) 0%, rgba(160,164,168,0.05) 40%, rgba(17,24,39,0) 100%);">
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-[1200px] items-center px-[60px] max-md:flex-col max-md:justify-between max-md:px-5 max-md:h-full">
    <div class="flex flex-1 flex-col gap-6 max-md:pt-20 max-md:items-center">
      <div class="inline-flex flex-col items-stretch max-w-[500px] max-md:max-w-none max-md:items-center">
        <h2 class="font-display text-[28px] sm:text-[36px] lg:text-[42px] font-black text-white leading-tight whitespace-nowrap w-full max-md:text-center" style="text-align-last: justify; text-justify: inter-character;">{fullName}</h2>
        <p class="font-body text-[16px] sm:text-[20px] lg:text-[26px] font-bold text-accent uppercase mt-1 whitespace-nowrap w-full max-md:text-center" style="text-align-last: justify; text-justify: inter-character;">{specialty}</p>
      </div>

      <div>
        <p class="hidden sm:block font-display text-[24px] sm:text-[34px] lg:text-[38px] text-accent-light/80 leading-tight font-bold">Problemas no trabalho?</p>
        <p class="hidden sm:block font-display text-[24px] sm:text-[34px] lg:text-[38px] leading-tight">
          <span class="text-accent-light/80 font-bold align-top">Defenda </span>
          <span class="text-accent font-bold uppercase tracking-wider text-[28px] sm:text-[42px] lg:text-[50px]">seus direitos</span>
        </p>

        <div class="sm:hidden flex flex-col leading-tight text-center">
          <p class="font-display text-[24px] text-accent-light/80 font-bold">Problemas no trabalho?</p>
          <p class="font-display text-[24px] text-accent-light/80 font-bold">Defenda</p>
          <p class="font-display text-[34px] font-bold text-accent uppercase tracking-wider mt-1">seus direitos</p>
        </div>
      </div>

      <div class="flex flex-col items-start max-md:hidden gap-2">
        <div class="flex flex-col items-center gap-2">
          <a
            href={WHATSAPP.url}
            class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-t from-[#72530a] to-accent px-9 py-4 font-body text-base font-semibold text-white transition-opacity hover:opacity-90"
          >
            Solicitar Atendimento
            <span class="text-lg">&rarr;</span>
          </a>
          <div class="flex items-center gap-1.5 text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span class="font-body text-xs">Atendimento em até 24 horas</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hidden lg:block absolute right-[60px] -top-10 w-[500px] h-[620px] rounded-lg overflow-hidden bg-cover bg-center shadow-2xl"
      style="background-image: url('/imgs/advogado.png')">
    </div>

    <div class="relative hidden max-md:flex flex-col items-center w-full mt-auto">
      <div class="relative w-[280px] h-[340px] rounded-lg overflow-hidden bg-cover bg-center shadow-2xl"
        style="background-image: url('/imgs/advogado.png')">
      </div>

      <div class="absolute top-[190px] left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <a
          href={WHATSAPP.url}
          class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-t from-[#72530a] to-accent px-5 py-3 font-body text-sm font-semibold text-white transition-opacity hover:opacity-90 shrink-0 whitespace-nowrap"
        >
          Solicitar Atendimento
          <span class="text-base">&rarr;</span>
        </a>
        <div class="flex items-center gap-1.5 text-muted">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span class="font-body text-xs">Atendimento em até 24 horas</span>
        </div>
      </div>
    </div>
  </div>
</section>
