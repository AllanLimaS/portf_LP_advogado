---
import { TESTIMONIALS } from "../constants/site"
---

<section id="depoimentos" class="w-full bg-primary">
  <div class="mx-auto max-w-[1200px] flex flex-col items-center gap-6 px-8 py-12">
    <div class="flex items-center gap-3">
      <span class="block h-0.5 w-8 bg-accent-dark"></span>
      <span class="font-body text-xs font-medium text-accent-dark tracking-[1.2px] uppercase">Depoimentos</span>
      <span class="block h-0.5 w-8 bg-accent-dark"></span>
    </div>

    <h3 class="text-center font-heading text-2xl font-medium text-accent-light">O que nossos clientes dizem</h3>

    <div class="grid w-full grid-cols-3 gap-4 max-md:grid-cols-1">
      {TESTIMONIALS.map((t) => (
        <div class="flex flex-col gap-3 rounded-xl border border-border-dark/50 bg-dark-card p-5">
          <span class="font-body text-sm text-accent-dark">&starf;&starf;&starf;&starf;&starf;</span>
          <p class="font-body text-[13px] italic text-accent-light/75 leading-relaxed">&ldquo;{t.quote}&rdquo;</p>
          <span class="block h-px w-full bg-border-dark"></span>
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-border-dark">
              <span class="font-body text-xs font-medium text-accent-light">{t.initials}</span>
            </div>
            <div class="flex flex-col">
              <span class="font-body text-[13px] font-medium text-accent-light">{t.name}</span>
              <span class="font-body text-[11px] text-accent-light/40">Cliente</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
