---
import "../styles/global.css"
import advogadoOgImg from "../assets/images/advogado.png"

export interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth" style="scroll-padding-top: 56px;">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(advogadoOgImg.src, Astro.site).href} />
    <meta property="og:url" content="https://ricardolauer.adv.br" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={new URL(advogadoOgImg.src, Astro.site).href} />
    <link rel="canonical" href="https://ricardolauer.adv.br" />
    <meta name="theme-color" content="#111827" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Attorney",
        "name": "Ricardo Lauer Advocacia",
        "image": "/imgs/advogado.png",
        "url": "https://ricardolauer.adv.br",
        "telephone": "+5511999996868",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Paulista, 1000",
          "addressLocality": "São Paulo",
          "addressRegion": "SP",
          "addressCountry": "BR"
        },
        "description": "Especialista em Direito Trabalhista. Atuação focada na defesa dos direitos dos trabalhadores.",
        "knowsAbout": "Direito Trabalhista",
        "areaServed": "Brasil"
      }
    </script>
  </head>
  <body class="font-body text-primary bg-bg antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-accent-dark focus:text-primary focus:px-4 focus:py-2 focus:rounded">Pular para o conteúdo principal</a>
    <slot />
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;

            if (el.classList.contains('reveal-stagger')) {
              const children = el.querySelectorAll(':scope > .reveal');
              children.forEach((child, i) => {
                child.style.transitionDelay = `${i * 120}ms`;
                child.classList.add('reveal-visible');
                child.addEventListener('transitionend', () => {
                  child.style.transitionDelay = '';
                }, { once: true });
              });
            } else {
              el.classList.add('reveal-visible');
            }

            observer.unobserve(el);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

        document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

        if (window.matchMedia('(hover: none)').matches) {
          let currentSpotlight = null;

          function updateSpotlight() {
            const cards = document.querySelectorAll('[data-spotlight]');
            const vh = window.innerHeight / 2;
            let bestCard = null;
            let bestDist = Infinity;

            cards.forEach(card => {
              const rect = card.getBoundingClientRect();
              const dist = Math.abs(rect.top + rect.height / 2 - vh);
              if (dist < bestDist) { bestDist = dist; bestCard = card; }
            });

            if (currentSpotlight && bestCard !== currentSpotlight) {
              const cr = currentSpotlight.getBoundingClientRect();
              const cd = Math.abs(cr.top + cr.height / 2 - vh);
              if (bestDist + 50 > cd) { bestCard = currentSpotlight; }
            }

            if (bestCard !== currentSpotlight) {
              if (currentSpotlight) {
                currentSpotlight.classList.remove('card-spotlight');
                const ov = currentSpotlight.querySelector('.card-overlay');
                if (ov) { ov.classList.remove('opacity-100'); ov.classList.add('opacity-0'); }
              }
              currentSpotlight = bestCard;
              if (bestCard) {
                bestCard.classList.add('card-spotlight');
                const ov = bestCard.querySelector('.card-overlay');
                if (ov) { ov.classList.add('opacity-100'); ov.classList.remove('opacity-0'); }
              }
            }
          }

          let ticking = false;
          window.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(() => { updateSpotlight(); ticking = false; });
              ticking = true;
            }
          }, { passive: true });

          updateSpotlight();
        }
      });
    </script>
  </body>
</html>
